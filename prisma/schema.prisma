// LiftLog - Multi-user fitness app. Auth via NextAuth Credentials.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  passwordHash   String
  createdAt      DateTime  @default(now())

  programs           Program[]
  profile            Profile?
  bodyMetricLogs     BodyMetricLog[]
  activitySessions   ActivitySession[]
}

model Program {
  id          String    @id @default(cuid())
  userId      String?   // optional during migration; set by scripts/migrate-to-multi-user
  name        String
  description String?
  createdAt   DateTime  @default(now())
  archivedAt  DateTime?

  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeks  Week[]
}

model Week {
  id         String    @id @default(cuid())
  programId  String
  weekNumber Int
  startDate  DateTime? // optional: week start (e.g. Monday) for display
  program    Program   @relation(fields: [programId], references: [id], onDelete: Cascade)

  days WorkoutDay[]
}

model WorkoutDay {
  id         String   @id @default(cuid())
  weekId     String
  dayNumber  Int
  name       String?  // e.g. "Push", "Pull", "Legs"
  week       Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)

  exercises Exercise[]
  sessions  WorkoutSession[]
}

model Exercise {
  id               String   @id @default(cuid())
  workoutDayId     String
  name             String
  orderIndex       Int      @default(0)
  substitution1    String?
  substitution2    String?
  /// Two exercises on the same day with the same non-null value are shown and logged as a superset pair.
  supersetGroupId  String?
  workoutDay       WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)

  templateSets     ExerciseSet[]
  loggedSets       LoggedSet[]
  displayOverrides ExerciseOverride[]

  @@index([workoutDayId, supersetGroupId])
}

model ExerciseSet {
  id             String   @id @default(cuid())
  exerciseId     String
  setNumber      Int
  targetReps     Int?     // upper bound (or exact) of rep range
  targetRepsMin  Int?     // lower bound of rep range; null means exact reps
  targetWeight   Float?
  targetRir      Int?
  exercise       Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model WorkoutSession {
  id           String   @id @default(cuid())
  workoutDayId String
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  isDeload     Boolean  @default(false)
  workoutDay   WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)

  loggedSets      LoggedSet[]
  exerciseOverrides ExerciseOverride[]
}

model ExerciseOverride {
  id               String   @id @default(cuid())
  workoutSessionId String
  exerciseId       String
  displayName     String
  note            String?

  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise       Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutSessionId, exerciseId])
}

model LoggedSet {
  id               String   @id @default(cuid())
  workoutSessionId String
  exerciseId       String
  setNumber        Int
  reps             Int?
  weight           Float?
  rir              Int?     // Reps in reserve (1-4 typical)
  isWarmup         Boolean? @default(false)
  /// True when the user intentionally lowered the weight to clean up form/technique.
  /// These sets are excluded from 1RM, volume, and progression analytics so they don't
  /// register as a strength regression — they reflect skill work.
  isFormDeload     Boolean? @default(false)
  completedAt      DateTime @default(now())

  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise       Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

// Per-user profile (height, age, gender). One row per user.
model Profile {
  id        String   @id @default(cuid())
  userId    String?  @unique // optional during migration
  heightCm  Float?
  age       Int?
  gender    String?
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Standalone training session not tied to a Program — e.g. travel HIIT, walks, conditioning.
/// Contributes to consistency and intensity score, but not to weight×reps volume or 1RM trend
/// (since there's no per-set load data).
model ActivitySession {
  id          String   @id @default(cuid())
  userId      String
  /// Type of activity: "cardio", "strength", "hiit", "walk", "mobility", "other".
  /// Stored as string for flexibility; UI offers a fixed list.
  kind        String
  /// User-facing name, e.g. "Hotel HIIT", "Sunday long walk".
  name        String
  startedAt   DateTime @default(now())
  durationMin Int?
  distanceMi  Float?
  /// Rate of perceived exertion 1-10. Maps to RIR-equivalent for intensity score.
  rpe         Int?
  note        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

// Daily log of body metrics (weight, body fat %) for progression/summary. One per user per day.
model BodyMetricLog {
  id        String   @id @default(cuid())
  userId    String?  // optional during migration
  date      DateTime
  weightLb  Float?
  bodyFatPct Float?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
